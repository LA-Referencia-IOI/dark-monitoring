{
  "uid": "dark-resources",
  "title": "dARK — Hosts and Containers",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reachable deployment machines",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [{"expr": "sum(dark_machine_probe_success)", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running managed containers",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "targets": [{"expr": "sum(dark_container_running)", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Collection age",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
      "targets": [{"expr": "time() - dark_metrics_export_timestamp_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 300}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst filesystem usage",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
      "targets": [{"expr": "max(100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container CPU",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [{"expr": "dark_container_cpu_percent", "legendFormat": "{{service}} @ {{machine}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container memory",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [{"expr": "dark_container_memory_bytes", "legendFormat": "{{service}} @ {{machine}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Managed container state",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 10},
      "targets": [{"expr": "dark_container_running", "instant": true, "format": "table", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Docker disk footprint",
      "description": "Docker object storage reported by docker system df; this is not filesystem or EBS capacity.",
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
      "targets": [{"expr": "sum by (machine, type) (dark_docker_disk_size_bytes)", "legendFormat": "{{machine}} {{type}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Docker reclaimable disk footprint",
      "description": "Reclaimable Docker object storage reported by docker system df; this is not filesystem free space.",
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
      "targets": [{"expr": "sum by (machine, type) (dark_docker_disk_reclaimable_bytes)", "legendFormat": "{{machine}} {{type}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Docker object count",
      "description": "Number of Docker objects reported by docker system df.",
      "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8},
      "targets": [{"expr": "sum by (machine, type) (dark_docker_disk_objects)", "legendFormat": "{{machine}} {{type}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}}
    }
  ]
}
