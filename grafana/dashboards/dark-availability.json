{
  "uid": "dark-availability",
  "title": "dARK — Availability",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Healthy probes",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7},
      "targets": [{"expr": "sum(probe_success{job=~\"blackbox-http|blackbox-json-rpc|blackbox-ipfs-api\"}) / count(probe_success{job=~\"blackbox-http|blackbox-json-rpc|blackbox-ipfs-api\"}) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 99}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Probe duration by endpoint",
      "gridPos": {"x": 8, "y": 0, "w": 16, "h": 7},
      "targets": [{"expr": "probe_duration_seconds{job=~\"blackbox-http|blackbox-json-rpc|blackbox-ipfs-api\"}", "legendFormat": "{{service}} {{site}} {{node}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Current endpoint status",
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 10},
      "targets": [{"expr": "probe_success{job=~\"blackbox-http|blackbox-json-rpc|blackbox-ipfs-api\"}", "instant": true, "format": "table", "refId": "A"}]
    }
  ]
}
