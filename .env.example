# Bindings are loopback-only. Put Grafana behind your authenticated VPN/reverse proxy.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-starting
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
BLACKBOX_PORT=9115

# Leave both values empty to discover targets from the deployer's .env and
# storage-topology.json. For a decoupled install, point to the public contract
# generated by `install.py deployment render`.
DARK_MONITOR_TARGETS_FILE=
# Alternatively, define the complete HTTP target list inline on one line.
DARK_MONITOR_TARGETS_JSON=[]
